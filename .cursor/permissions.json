{
  // Auto-approve desenvolvimento — commits/push bloqueados via hooks
  // Docs: https://cursor.com/docs/reference/permissions
  // Run Mode: Cursor Settings → Agent → Run Everything (recomendado)

  "mcpAllowlist": ["*:*"],

  "terminalAllowlist": [
    "cd",
    "Set-Location",
    "powershell",
    "pwsh",
    "cmd",
    "docker",
    "docker compose",
    "npm",
    "npx",
    "node",
    "nest",
    "next",
    "vitest",
    "jest",
    "eslint",
    "prettier",
    "concurrently",
    "playwright",
    "curl",
    "wget",
    "Invoke-RestMethod",
    "Invoke-WebRequest",
    "Write-Host",
    "Start-Process",
    "Start-Sleep",
    "mkdir",
    "copy",
    "cp",
    "mv",
    "type",
    "cat",
    "Get-Content",
    "Select-String",
    "findstr",
    "where",
    "openssl",
    "gh",
    "git status",
    "git diff",
    "git log",
    "git branch",
    "git remote",
    "git show",
    "git check-ignore",
    "git ls-files",
    "git rev-parse",
    "git describe",
    "git fetch",
    "git pull"
  ],

  "autoRun": {
    "allow_instructions": [
      "Auto-aprovar todos os comandos de desenvolvimento: npm, docker compose (incluindo stop/up/build), build, testes, lint, nest, next, playwright, curl, PowerShell e comandos compostos com cd.",
      "Auto-aprovar edição e criação de arquivos no workspace durante implementações.",
      "Auto-aprovar todas as ferramentas MCP.",
      "Na revisão de alterações do agente, aceitar sempre Keep All / aplicar todas as mudanças sem pedir confirmação por arquivo.",
      "Auto-aprovar leituras Git: status, diff, log, branch, fetch, pull."
    ],
    "block_instructions": [
      "Nunca auto-executar git commit, git push, git add ou publicação no remoto sem pedido explícito do usuário.",
      "Nunca auto-executar git reset --hard, push --force, clean -fd ou comandos destrutivos.",
      "Nunca commitar .env, secrets ou data/ sem revisão explícita."
    ]
  }
}
