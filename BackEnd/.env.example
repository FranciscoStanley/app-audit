# Ambiente: development | production
NODE_ENV=development

# Porta da API
PORT=3000
CORS_ORIGIN=http://localhost:3001

# JWT — em produção use segredo com 32+ caracteres (openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Administrador inicial (criado apenas se data/users.json estiver vazio)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Swagger — em produção desabilitado por padrão; defina true para habilitar
SWAGGER_ENABLED=false

# GitHub OAuth — login com GitHub e auditoria nos repositórios do usuário
# Crie em: https://github.com/settings/developers → OAuth Apps
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/auth/github/callback
FRONTEND_URL=http://localhost:3001

# LGPD — controlador e contato do encarregado/DPO
DATA_CONTROLLER_NAME=App Audit
DATA_CONTROLLER_ADDRESS=
PRIVACY_CONTACT_EMAIL=franciscothestanley@gmail.com
DPO_CONTACT_EMAIL=franciscothestanley@gmail.com

# GitHub — token para API e GitHub Advisory Database
# Gere em: https://github.com/settings/tokens
GITHUB_TOKEN=

# OpenSourceMalware — token para check-malicious e query-latest
# Gere em: https://opensourcemalware.com/
OSM_API_TOKEN=

# Threat intelligence
THREAT_INTEL_REFRESH_HOURS=6
THREAT_INTEL_SYNC_ON_STARTUP=true
GITHUB_ADVISORY_MAX_PAGES=10
