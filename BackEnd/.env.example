# Ambiente: development | production
NODE_ENV=development

# Porta da API
PORT=3000
CORS_ORIGIN=http://localhost:3001

# JWT — em produção use segredo com 32+ caracteres (openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Administrador inicial (criado apenas se data/users.json estiver vazio)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Swagger — em produção desabilitado por padrão; defina true para habilitar
SWAGGER_ENABLED=false

# GitHub — token para API e GitHub Advisory Database
# Gere em: https://github.com/settings/tokens
GITHUB_TOKEN=

# OpenSourceMalware — token para check-malicious e query-latest
# Gere em: https://opensourcemalware.com/
OSM_API_TOKEN=

# Threat intelligence
THREAT_INTEL_REFRESH_HOURS=6
THREAT_INTEL_SYNC_ON_STARTUP=true
GITHUB_ADVISORY_MAX_PAGES=10
