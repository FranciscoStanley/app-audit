# Oracle Cloud — copie para .env na VM após clonar o repositório:
#   cp .env.oracle.example .env
#
# Substitua app-audit no hosts pelo IP público da VM (Console OCI → Compute → Instance).
# Windows: C:\Windows\System32\drivers\etc\hosts  →  IP_PUBLICO app-audit

NODE_ENV=production

BACKEND_PORT=3000
FRONTEND_PORT=3001

# URLs com hostname app-audit (requer entrada no arquivo hosts)
CORS_ORIGIN=http://app-audit:3001
NEXT_PUBLIC_API_URL=http://app-audit:3000

# Com domínio próprio (descomente e use o profile proxy do compose):
# DOMAIN=audit.seudominio.com
# CORS_ORIGIN=https://audit.seudominio.com
# NEXT_PUBLIC_API_URL=https://api.seudominio.com
# GITHUB_OAUTH_CALLBACK_URL=https://api.seudominio.com/v1/auth/github/callback
# FRONTEND_URL=https://audit.seudominio.com

# openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=8h

ADMIN_EMAIL=franciscothestanley@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME=Francisco Stanley Rodrigues Albuquerque
ADMIN_GITHUB_USERNAME=FranciscoStanley

SWAGGER_ENABLED=false

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://app-audit:3000/v1/auth/github/callback
FRONTEND_URL=http://app-audit:3001

GITHUB_TOKEN=
OSM_API_TOKEN=

THREAT_INTEL_REFRESH_HOURS=6
THREAT_INTEL_SYNC_ON_STARTUP=true
GITHUB_ADVISORY_MAX_PAGES=10

DATA_CONTROLLER_NAME=App Audit
DATA_CONTROLLER_ADDRESS=
PRIVACY_CONTACT_EMAIL=franciscothestanley@gmail.com
DPO_CONTACT_EMAIL=franciscothestanley@gmail.com

# Imagens GHCR (opcional — deploy.sh preenche após release)
# BACKEND_IMAGE=ghcr.io/franciscostanley/app-audit-backend:latest
# FRONTEND_IMAGE=ghcr.io/franciscostanley/app-audit-frontend:latest
# APP_VERSION=latest
